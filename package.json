{
  "name": "react-resume-template",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "yarn compile && yarn next build",
    "clean": "rm -rf build-tsc .next",
    "compile": "yarn run -T tsc --build --verbose",
    "dev": "yarn compile && yarn next dev",
    "lint": "yarn run -T prettier --write ./src/**/*.{js,jsx,json,ts,tsx} && eslint ./src/**/*.{js,jsx,ts,tsx} --fix --max-warnings=0",
    "start": "yarn next start",
    "sitemap": "yarn next-sitemap"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "next": "^16.0.1",
    "nodemailer": "^7.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.2.2",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.4.0",
    "prettier": "^3.7.3",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sass": "^1.93.3",
    "sort-package-json": "^3.4.0",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3"
  }
}
